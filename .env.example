# ==========================================
# ZAPTROLL - ENVIRONMENT CONFIGURATION
# ==========================================
# IMPORTANTE: Copie este arquivo para .env e preencha todos os campos obrigatórios.
# Em produção, senhas fracas ou valores padrão farão o backend recusar a inicialização.

# Application
NODE_ENV=production
PORT=3001
APP_URL=http://localhost:3000

# PostgreSQL Database
# Configure uma senha forte e exclusiva para o banco de dados
DB_HOST=postgres
DB_PORT=5432
DB_USER=zaptroll_user
DB_PASSWORD=sua_senha_segura_do_postgres_aqui
DB_NAME=zaptroll_db
DATABASE_URL=postgres://zaptroll_user:sua_senha_segura_do_postgres_aqui@postgres:5432/zaptroll_db

# Security & Authentication
# JWT_SECRET: Chave secreta exclusiva com no mínimo 32 caracteres (ex: openssl rand -base64 32)
JWT_SECRET=gere_uma_chave_secreta_aleatoria_com_mais_de_32_caracteres_12345
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# First Admin Provisioning (Criado automaticamente na primeira execução se nenhum admin existir)
# A senha DEVE ter no mínimo 8 caracteres e NÃO pode ser senhas comuns
FIRST_ADMIN_NAME=Administrador
FIRST_ADMIN_EMAIL=admin@seudominio.com
FIRST_ADMIN_PASSWORD=SenhaForteAdmin@2026!

# Limits & Quotas
DEFAULT_MAX_CONNECTIONS_PER_USER=3
DEFAULT_RATE_LIMIT_PER_MINUTE=120

# WhatsApp / Zapo Storage
ZAPO_STORE_PREFIX=wa_
CACHE_CLEANUP_INTERVAL_MS=60000

# CORS Whitelist (separada por vírgula, sem barra no final; em produção NÃO use "*")
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://seu-dominio-frontend.com

# Kordix TTS Voice API (https://zone.api.br/store)
KORDIX_API_KEY=sua_key_aqui
# Opcional: múltiplas chaves separadas por vírgula para rotação e fallback automático
# KORDIX_API_KEYS=key1,key2,key3
