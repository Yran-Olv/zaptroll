# ==========================================
# ZAPTROLL - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=production
PORT=3001
APP_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgres://zaptroll_user:zaptroll_secret_pass@postgres:5432/zaptroll_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=zaptroll_user
DB_PASSWORD=zaptroll_secret_pass
DB_NAME=zaptroll_db

# Security & Authentication
JWT_SECRET=zaptroll_super_secure_jwt_secret_change_in_production_32chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# First Admin Provisioning (Auto-seeded safely on initial boot)
FIRST_ADMIN_NAME=Admin Zaptroll
FIRST_ADMIN_EMAIL=admin@zaptroll.local
FIRST_ADMIN_PASSWORD=Admin@SecurePass2026!

# Limits & Quotas
DEFAULT_MAX_CONNECTIONS_PER_USER=3
DEFAULT_RATE_LIMIT_PER_MINUTE=120

# WhatsApp / Zapo Storage
ZAPO_STORE_PREFIX=wa_
CACHE_CLEANUP_INTERVAL_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:80
